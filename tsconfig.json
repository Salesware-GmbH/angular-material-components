{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "strict": false,
    "typeRoots": [
      "node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@angular-material-components/*": [
        "./dist/@angular-material-components/*"
      ],
      "@angular-material-components/color-picker": [
        "./dist/@angular-material-components/color-picker"
      ],
      "@angular-material-components/color-picker/*": [
        "./dist/@angular-material-components/color-picker/*"
      ],
      "@salesware/angular-material-components-datetime-picker": [
        "./dist/@salesware/angular-material-components-datetime-picker"
      ],
      "@salesware/angular-material-components-datetime-picker/*": [
        "./dist/@salesware/angular-material-components-datetime-picker/*"
      ],
      "file-input": [
        "./dist/file-input"
      ],
      "file-input/*": [
        "./dist/file-input/*"
      ]
    },
    "useDefineForClassFields": false
  }
}